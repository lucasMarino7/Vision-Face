# Arquivo de EXEMPLO (vai para o GitHub, apenas valores fictícios).
# Copie para ".env" na raiz do projeto e preencha com os valores reais.
# O ".env" é usado localmente por: docker compose, backend, frontend (vite) e raspberry.
# No Coolify (produção) estas variáveis são definidas diretamente no painel.

# ---------- Postgres ----------
POSTGRES_DB=vision_face
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=troque_esta_senha
# porta publicada no host (somente 127.0.0.1) para acessar com pgadmin
POSTGRES_PORT=5432
# URI usada fora do docker (flask local). Dentro do docker o compose monta a URI com o host "postgres".
DATABASE_URL=postgresql+psycopg://vision_user:troque_esta_senha@localhost:5432/vision_face

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Backend (Flask) ----------
SECRET_KEY=troque_por_uma_chave_aleatoria
SECURITY_PASSWORD_SALT=troque_por_um_salt_aleatorio
BACKEND_IP=0.0.0.0
# porta publicada no host para o backend (interna do container é sempre 8000)
BACKEND_PORT=8000
ENV=production
FLASK_APP=main

# ---------- Frontend ----------
# porta publicada no host para o frontend (nginx)
FRONTEND_PORT=3000
# URL do WebSocket da Raspberry acessada PELO NAVEGADOR (build-time do frontend).
# Em site https é obrigatório usar wss:// (via proxy/túnel); em rede local pode ser ws://IP_DA_RASP:8765
RASPBERRY_WS_URL=ws://192.168.0.50:8765

# ---------- Raspberry ----------
# URL da API do backend acessada PELA RASPBERRY (ex.: http://IP_DO_SERVIDOR:8000/api ou https://dominio/api)
API_URL=http://192.168.0.10:8000/api
SYNC_INTERVAL_SECONDS=30
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
INSIGHTFACE_MODEL=buffalo_l
FACE_MIN_DETECTION_SCORE=0.5
FACE_MATCH_DISTANCE_THRESHOLD=
FACE_LOG_FULL_EMBEDDING=false
